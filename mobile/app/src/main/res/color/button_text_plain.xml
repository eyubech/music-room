<?xml version="1.0" encoding="utf-8"?>
<!-- White text for outlined and text buttons; gold when checked in a toggle group. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.38" android:color="@color/on_surface" android:state_enabled="false" />
    <item android:color="@color/gold_light" android:state_checked="true" />
    <item android:color="@color/on_surface" />
</selector>
