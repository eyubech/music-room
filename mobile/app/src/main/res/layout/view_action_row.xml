<?xml version="1.0" encoding="utf-8"?>
<!-- A tappable row of an actions card: icon, label, chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/card_padding">

    <ImageView
        android:id="@+id/action_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:tint="?attr/colorSecondary" />

    <TextView
        android:id="@+id/action_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <ImageView
        android:id="@+id/action_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/muted" />
</LinearLayout>
