<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header: drifting aurora behind a ringed avatar -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.musicroom.app.ui.widget.AuroraView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/screen_margin"
                        android:paddingTop="@dimen/space_xxl"
                        android:paddingBottom="@dimen/space_xl">

                        <FrameLayout
                            android:layout_width="124dp"
                            android:layout_height="124dp">

                            <com.musicroom.app.ui.widget.GlowRingView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <TextView
                                android:id="@+id/avatar"
                                android:layout_width="104dp"
                                android:layout_height="104dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_avatar"
                                android:gravity="center"
                                android:textColor="@color/on_gold"
                                android:textSize="44sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/display_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.MusicRoom.Display"
                            android:textSize="32sp" />

                        <TextView
                            android:id="@+id/email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/verified"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="@string/profile_email_verified"
                            android:textAppearance="@style/TextAppearance.MusicRoom.Badge" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:paddingBottom="@dimen/screen_margin">

                    <!-- Public -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MusicRoom.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="8dp"
                                android:text="@string/profile_section_public"
                                android:textAppearance="@style/TextAppearance.MusicRoom.Label"
                                app:drawableStartCompat="@drawable/ic_public"
                                app:drawableTint="?attr/colorSecondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_section_public_hint"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <include
                                android:id="@+id/field_bio"
                                layout="@layout/item_profile_field" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Friends only -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MusicRoom.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="8dp"
                                android:text="@string/profile_section_friends"
                                android:textAppearance="@style/TextAppearance.MusicRoom.Label"
                                app:drawableStartCompat="@drawable/ic_person"
                                app:drawableTint="?attr/colorSecondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_section_friends_hint"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <include
                                android:id="@+id/field_real_name"
                                layout="@layout/item_profile_field" />

                            <include
                                android:id="@+id/field_city"
                                layout="@layout/item_profile_field" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Private -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MusicRoom.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="8dp"
                                android:text="@string/profile_section_private"
                                android:textAppearance="@style/TextAppearance.MusicRoom.Label"
                                app:drawableStartCompat="@drawable/ic_lock"
                                app:drawableTint="?attr/colorSecondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_section_private_hint"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <include
                                android:id="@+id/field_phone"
                                layout="@layout/item_profile_field" />

                            <include
                                android:id="@+id/field_birth_date"
                                layout="@layout/item_profile_field" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Music preferences -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MusicRoom.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="8dp"
                                android:text="@string/profile_section_music"
                                android:textAppearance="@style/TextAppearance.MusicRoom.Label"
                                app:drawableStartCompat="@drawable/ic_music_note"
                                app:drawableTint="?attr/colorSecondary" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/genres"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp" />

                            <TextView
                                android:id="@+id/no_genres"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/profile_no_genres"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Linked accounts -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MusicRoom.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_section_accounts"
                                android:textAppearance="@style/TextAppearance.MusicRoom.Label" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/profile_google"
                                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                                <Button
                                    android:id="@+id/google_link_button"
                                    style="@style/Widget.MusicRoom.Button.Tonal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/profile_link" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Account actions -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/section_gap"
                        android:text="@string/label_account"
                        android:textAppearance="@style/TextAppearance.MusicRoom.Label" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MusicRoom.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/edit_button"
                                layout="@layout/view_action_row" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="58dp"
                                android:background="@color/hairline" />

                            <include
                                android:id="@+id/settings_button"
                                layout="@layout/view_action_row" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="58dp"
                                android:background="@color/hairline" />

                            <include
                                android:id="@+id/logout_button"
                                layout="@layout/view_action_row" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/state"
            layout="@layout/view_state" />

        <include
            android:id="@+id/skeleton"
            layout="@layout/skeleton_profile" />
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
