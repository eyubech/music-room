<?xml version="1.0" encoding="utf-8"?>
<!-- Loading state of the profile: avatar, name, email, then the section cards. -->
<com.musicroom.app.ui.widget.ShimmerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="32dp">

        <View
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_bone_round" />

        <View
            android:layout_width="160dp"
            android:layout_height="28dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_bone" />

        <View
            android:layout_width="200dp"
            android:layout_height="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_bone" />

        <View
            android:layout_width="84dp"
            android:layout_height="22dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_bone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_bone_card" />

        <View
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_bone_card" />

        <View
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_bone_card" />
    </LinearLayout>
</com.musicroom.app.ui.widget.ShimmerLayout>
