<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder with the same geometry as item_entry.xml. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp">

    <View
        android:id="@+id/bone_cover"
        android:layout_width="@dimen/cover_size"
        android:layout_height="@dimen/cover_size"
        android:background="@drawable/bg_bone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bone_title"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_bone"
        app:layout_constraintBottom_toTopOf="@id/bone_subtitle"
        app:layout_constraintStart_toEndOf="@id/bone_cover"
        app:layout_constraintTop_toTopOf="@id/bone_cover"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.45" />

    <View
        android:id="@+id/bone_subtitle"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_bone"
        app:layout_constraintBottom_toBottomOf="@id/bone_cover"
        app:layout_constraintStart_toEndOf="@id/bone_cover"
        app:layout_constraintTop_toBottomOf="@id/bone_title"
        app:layout_constraintWidth_percent="0.30" />

    <View
        android:layout_width="56dp"
        android:layout_height="20dp"
        android:background="@drawable/bg_bone"
        app:layout_constraintBottom_toBottomOf="@id/bone_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bone_cover" />
</androidx.constraintlayout.widget.ConstraintLayout>
