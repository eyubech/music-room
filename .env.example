# Copy to .env (`make setup` does it and generates the secrets) and fill in the rest.
# .env is git-ignored: never commit real credentials (subject V.8).

# --- Database (docker compose service: db) ---
DB_NAME=musicroom
DB_USER=musicroom
DB_PASSWORD=change-me
DB_PORT=5432

# --- Mail catcher (docker compose service: mail) ---
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# --- Backend ---
JWT_SECRET=change-me
APP_BASE_URL=http://localhost:8080

# --- Mobile app (read at build time by mobile/app/build.gradle) ---
# Default API address baked into the app; it can be changed at runtime in Settings.
# 10.0.2.2 is the host machine as seen from the Android emulator.
MOBILE_DEFAULT_API_URL=http://10.0.2.2:8080/

# --- Social login ---
# OAuth "Web application" client ID from console.cloud.google.com (used by app and backend).
# Leave empty to disable Google sign-in.
GOOGLE_WEB_CLIENT_ID=
